{
  "name": "gxpllm",
  "version": "0.1.0",
  "description": "gxpllm — clinical trial data analysis for agentic coding hosts: a local LLM writes SAS/Python/R, runners execute them with a tamper-evident audit trail, and the orchestrating model never sees patient data.",
