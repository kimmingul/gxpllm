# Keep LF everywhere: SKILL.md frontmatter checks and hook scripts assume LF,
# and Windows contributors with core.autocrlf=true would otherwise break them.
* text=auto eol=lf

# SAS macros and R sources are read by interpreters that tolerate LF on Windows.
*.sas text eol=lf
*.R   text eol=lf
*.py  text eol=lf

*.jpg binary
*.png binary
*.pdf binary
*.rtf binary
